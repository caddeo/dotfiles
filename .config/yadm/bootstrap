#!/usr/bin/env fish
set os (uname -s)
set class (yadm config local.class)

# --- Tools ---

if not type -q mise
    curl https://mise.run | sh
end

~/.local/bin/mise activate fish | source
mise install

# --- Platform packages ---

if test $os = Darwin
    brew bundle --global
else if test -f /etc/arch-release
    sudo pacman -S --needed - <~/.config/packages/pkglist
end

# --- Tmux plugins ---

# TPM (Tmux Plugin Manager)
if not test -d ~/.tmux/plugins/tpm
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
end

# Catppuccin (manual install required for cyberdream theme - avoids name conflicts)
if not test -d ~/.config/tmux/plugins/catppuccin/tmux/.git
    git clone --depth 1 https://github.com/catppuccin/tmux ~/.config/tmux/plugins/catppuccin/tmux
end

# Cyberdream theme for catppuccin tmux
set -l cyberdream ~/.config/tmux/plugins/catppuccin/tmux/themes/catppuccin_cyberdream_tmux.conf
if not test -f $cyberdream
    curl -fsSL "https://raw.githubusercontent.com/scottmckendry/cyberdream.nvim/main/extras/tmux/cyberdream.conf" -o $cyberdream
end

# --- Alternates ---

# Disable automatic alternates on status/checkout/pull/merge (prevents file watcher/warning issues)
yadm config yadm.auto-alt false
yadm alt

# --- Post-install reloads ---

# If we are on Arch and inside a Hyprland session, reload config to apply alternates without autogenerated warning
if test -f /etc/arch-release; and set -q HYPRLAND_INSTANCE_SIGNATURE; and type -q hyprctl
    hyprctl reload
end
